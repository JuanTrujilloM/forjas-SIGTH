# Copy to .env and fill in; never commit .env

# Django
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# SQL Server
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server
# TrustServerCertificate=yes for a local container; empty in production
DB_EXTRA_PARAMS=

# Frontend origins allowed by CORS, comma separated; never a wildcard
CORS_ALLOWED_ORIGINS=

# Origins allowed to send unsafe requests (CSRF), comma separated
CSRF_TRUSTED_ORIGINS=

# Domain of the corporate email used to log in, without the @
CORPORATE_EMAIL_DOMAIN=

# Reverse proxies in front of Django; 0 when it receives the requests directly
NUM_PROXIES=0

# Folder for the employee photos; empty uses backend/media/
MEDIA_ROOT=

# Development only: password of the demo accounts, at least 12 characters
DEMO_USERS_PASSWORD=
