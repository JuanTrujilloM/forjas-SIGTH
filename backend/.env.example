# Copy to .env and fill in. Never commit .env (10.2).

# Django
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# SQL Server
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server
# TrustServerCertificate=yes for a local container; empty in production
DB_EXTRA_PARAMS=

# Frontend origins allowed by CORS, comma separated. Never use a wildcard (4.4).
CORS_ALLOWED_ORIGINS=

# Origins allowed to send unsafe requests (CSRF), comma separated
CSRF_TRUSTED_ORIGINS=

# Domain of the corporate email used to log in, without the @ (2)
CORPORATE_EMAIL_DOMAIN=

# Folder for uploaded files (employee photos). Empty uses backend/media/, which is only
# for development: in production IT sets a folder outside the code and backs it up.
# It holds personal data and must never be served directly by the web server.
MEDIA_ROOT=

# Development only: password of the demo accounts that `manage.py seed_demo_users` creates,
# one per access profile. At least 12 characters. Leave it empty in production.
DEMO_USERS_PASSWORD=
