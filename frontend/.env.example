# Copy to .env and fill in; never commit .env
# Vite inlines VITE_ vars into the bundle as plain text: never put a secret here

# Its origin must be in CORS_ALLOWED_ORIGINS in backend/.env. Dev: http://localhost:8000/api
VITE_API_BASE_URL=

# Domain the login form checks before calling the API; the backend validates it again
VITE_CORPORATE_EMAIL_DOMAIN=
