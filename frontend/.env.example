# Copy to .env and fill in. Never commit .env (10.2).
# Vite inlines VITE_-prefixed vars into the bundle as plain text: never put a secret here.

# Its origin must be in CORS_ALLOWED_ORIGINS in backend/.env. Dev: http://localhost:8000/api
VITE_API_BASE_URL=

# Domain the login form checks before calling the API. Not a secret: the backend
# validates it again and is the one that decides (3.3).
VITE_CORPORATE_EMAIL_DOMAIN=
